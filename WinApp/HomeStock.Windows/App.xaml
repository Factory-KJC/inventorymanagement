<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="HomeStock.Windows.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" />
      </Style>
      <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#172033, Dark=#F1F5F9}" />
      </Style>
      <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#1D4ED8, Dark=#3B82F6}" />
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="VisualStateManager.VisualStateGroups">
          <VisualStateGroupList>
            <VisualStateGroup x:Name="CommonStates">
              <VisualState x:Name="Normal" />
              <VisualState x:Name="Disabled">
                <VisualState.Setters>
                  <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#94A3B8, Dark=#475569}" />
                  <Setter Property="TextColor" Value="{AppThemeBinding Light=#F8FAFC, Dark=#CBD5E1}" />
                </VisualState.Setters>
              </VisualState>
            </VisualStateGroup>
          </VisualStateGroupList>
        </Setter>
      </Style>
      <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" />
      </Style>
      <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" />
      </Style>
      <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" />
      </Style>
      <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{AppThemeBinding Light=#1D4ED8, Dark=#60A5FA}" />
      </Style>
      <Style TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light=#CBD5E1, Dark=#475569}" />
      </Style>
      <Style TargetType="CollectionView">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#111827}" />
      </Style>
      <Style x:Key="TableHeader" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#DCE6F2, Dark=#334155}" />
      </Style>
      <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
      </Style>
      <Style x:Key="MutedLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
      </Style>
      <Style x:Key="StatusLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
