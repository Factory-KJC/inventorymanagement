# Copy to .env. Never commit .env.
POSTGRES_DB=homestock
POSTGRES_USER=homestock
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_ISSUER=home-stock
JWT_AUDIENCE=home-stock-clients
JWT_KEY=replace-with-at-least-32-random-bytes
SETUP_TOKEN=replace-with-a-separate-long-random-value

# Windows development
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
WEB_ORIGIN=http://localhost:3000
DATABASE_AUTO_MIGRATE=true

# Debian production
PUBLIC_HOST=stock.example.com
